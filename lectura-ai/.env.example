# Environment: development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Secret
JWT_SECRET=super_secret_jwt_token_change_in_production_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL)
POSTGRES_USER=lectura
POSTGRES_PASSWORD=lectura_secret_123
POSTGRES_DB=lectura_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lectura:lectura_secret_123@localhost:5432/lectura_db
DATABASE_SYNC_URL=postgresql://lectura:lectura_secret_123@localhost:5432/lectura_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Models & LLM Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_FAST_MODEL_NAME=gpt-4o-mini

# Google / YouTube Data API v3 (Optional if using public transcript extraction)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Vite API Base URL
VITE_API_BASE_URL=http://localhost:8000
