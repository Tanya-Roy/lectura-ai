# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Lectura AI"
APP_VERSION="0.1.0"

# Database Configuration (PostgreSQL Async + Sync for Alembic)
DATABASE_URL=postgresql+asyncpg://lectura:lectura_secret_123@localhost:5432/lectura_db
DATABASE_SYNC_URL=postgresql://lectura:lectura_secret_123@localhost:5432/lectura_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super_secret_jwt_token_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_FAST_MODEL_NAME=gpt-4o-mini
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Feature Flags
ENABLE_VERIFICATION_AGENT=true
ENABLE_QUIZ_GENERATION=true
ENABLE_FLASHCARD_GENERATION=true
